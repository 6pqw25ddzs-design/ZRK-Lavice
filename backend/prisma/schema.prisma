generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  parent
  coach
  admin
}

enum TeamCategory {
  mini
  pioniri
  prva_liga
}

enum EventType {
  training
  match
}

enum AttendanceStatus {
  present
  absent
  excused
}

enum AvailabilityStatus {
  yes
  no
  maybe
}

enum RegistrationStatus {
  pending
  approved
  rejected
  scheduled
  attended
  enrolled
}

enum ConsentType {
  media
  data
  travel
}

enum FeeStatus {
  unpaid
  paid
  waived
}

enum EvalDomain {
  technical
  tactical
  physical
  mental
  goalkeeper
}

enum GoalStatus {
  active
  done
  paused
}

enum InjuryStatus {
  ready
  caution
  out
}

enum FinanceKind {
  income
  expense
}

enum SponsorLevel {
  gold
  silver
  bronze
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  phone        String?
  fcmToken     String?  @map("fcm_token")
  googleId     String?  @unique @map("google_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  players          Player[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  newsArticles     NewsArticle[]
  notifications    Notification[]
  coach            Coach?
  parentLinks      ParentLink[]
  usedInvites      InviteCode[]
  pushTokens       PushToken[]
  availabilityResponses Availability[]
  announcements    Announcement[]
  announcementReads AnnouncementRead[]
  signedConsents   Consent[]
  evaluationsGiven Evaluation[]
  goalsGiven       DevelopmentGoal[]
  financeEntries   FinanceEntry[]

  @@map("users")
}

model Team {
  id          String       @id @default(uuid())
  name        String
  category    TeamCategory
  birthYear   Int?         @map("birth_year")
  season      String
  description String?
  logoUrl     String?      @map("logo_url")

  players  Player[]
  coaches  Coach[]
  events   ScheduleEvent[]
  messages Message[]
  notifications Notification[]
  assignments TeamAssignment[]
  announcements Announcement[]

  @@map("teams")
}

model Player {
  id           String   @id @default(uuid())
  teamId       String   @map("team_id")
  parentUserId String?  @map("parent_user_id")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  birthDate    DateTime @map("birth_date")
  jerseyNumber Int?     @map("jersey_number")
  position     String?
  photoUrl     String?  @map("photo_url")
  isActive     Boolean  @default(true) @map("is_active")
  joinedDate   DateTime @default(now()) @map("joined_date")

  team        Team             @relation(fields: [teamId], references: [id])
  parentUser  User?            @relation(fields: [parentUserId], references: [id])
  attendance   Attendance[]
  parentLinks  ParentLink[]
  inviteCodes  InviteCode[]
  assignments  TeamAssignment[]
  availability Availability[]
  documents    PlayerDocument[]
  consents     Consent[]
  fees         MembershipFee[]
  medicalInfo  MedicalInfo?
  emergencyContacts EmergencyContact[]
  evaluations  Evaluation[]
  goals        DevelopmentGoal[]
  milestones   Milestone[]
  injuries     InjuryRecord[]
  equipment    EquipmentItem[]

  @@map("players")
}

model Coach {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  teamId      String  @map("team_id")
  bio         String?
  licenseNo   String? @map("license_no")
  achievements String?
  photoUrl    String? @map("photo_url")
  isHeadCoach Boolean @default(false) @map("is_head_coach")

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@map("coaches")
}

model ScheduleEvent {
  id          String    @id @default(uuid())
  teamId      String    @map("team_id")
  type        EventType
  title       String
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  location    String?
  opponent    String?
  isCancelled Boolean   @default(false) @map("is_cancelled")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  team         Team          @relation(fields: [teamId], references: [id])
  result       MatchResult?
  attendance   Attendance[]
  availability Availability[]

  @@map("schedule_events")
}

model MatchResult {
  id        String   @id @default(uuid())
  eventId   String   @unique @map("event_id")
  homeScore Int      @map("home_score")
  awayScore Int      @map("away_score")
  scorers   Json?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  event ScheduleEvent @relation(fields: [eventId], references: [id])

  @@map("match_results")
}

model Attendance {
  id       String           @id @default(uuid())
  eventId  String           @map("event_id")
  playerId String           @map("player_id")
  status   AttendanceStatus

  event  ScheduleEvent @relation(fields: [eventId], references: [id])
  player Player        @relation(fields: [playerId], references: [id])

  @@unique([eventId, playerId])
  @@map("attendance")
}

model NewsArticle {
  id          String    @id @default(uuid())
  authorId    String    @map("author_id")
  title       String
  slug        String    @unique
  body        String
  coverUrl    String?   @map("cover_url")
  publishedAt DateTime? @map("published_at")
  isPublished Boolean   @default(false) @map("is_published")
  tags        String[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])

  @@map("news_articles")
}

model Message {
  id          String    @id @default(uuid())
  senderId    String    @map("sender_id")
  recipientId String?   @map("recipient_id")
  teamId      String?   @map("team_id")
  body        String
  isGroup     Boolean   @default(false) @map("is_group")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sender    User  @relation("SentMessages", fields: [senderId], references: [id])
  recipient User? @relation("ReceivedMessages", fields: [recipientId], references: [id])
  team      Team? @relation(fields: [teamId], references: [id])

  @@map("messages")
}

model Registration {
  id          String             @id @default(uuid())
  childName   String             @map("child_name")
  birthYear   Int                @map("birth_year")
  parentName  String             @map("parent_name")
  parentPhone String             @map("parent_phone")
  parentEmail String             @map("parent_email")
  status      RegistrationStatus @default(pending)
  notes       String?
  trialSlotId String?            @map("trial_slot_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  trialSlot TrialSlot? @relation(fields: [trialSlotId], references: [id])

  @@map("registrations")
}

model Notification {
  id        String   @id @default(uuid())
  senderId  String   @map("sender_id")
  teamId    String?  @map("team_id")
  title     String
  body      String
  channel   String   @default("push")
  sentAt    DateTime @default(now()) @map("sent_at")

  sender User  @relation(fields: [senderId], references: [id])
  team   Team? @relation(fields: [teamId], references: [id])

  @@map("notifications")
}

model Sponsor {
  id          String       @id @default(uuid())
  name        String
  level       SponsorLevel
  logoUrl     String?      @map("logo_url")
  websiteUrl  String?      @map("website_url")
  contractEnd DateTime?    @map("contract_end")
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")

  @@map("sponsors")
}

model Document {
  id         String   @id @default(uuid())
  title      String
  category   String
  fileUrl    String   @map("file_url")
  uploadedBy String   @map("uploaded_by")
  isPublic   Boolean  @default(false) @map("is_public")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("documents")
}

model GalleryImage {
  id        String   @id @default(uuid())
  title     String?
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("gallery_images")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model LeagueStanding {
  id            String   @id @default(uuid())
  league        String
  teamName      String   @map("team_name")
  played        Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  goalsFor      Int      @default(0) @map("goals_for")
  goalsAgainst  Int      @default(0) @map("goals_against")
  points        Int      @default(0)
  isOwnTeam     Boolean  @default(false) @map("is_own_team")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("league_standings")
}

// ===== Faza 1: temelj operativne platforme =====

model Season {
  id        String   @id @default(uuid())
  name      String   @unique
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  assignments TeamAssignment[]

  @@map("seasons")
}

// Istorija pripadnosti igračice ekipi po sezoni (čuva putanju razvoja kroz kategorije)
model TeamAssignment {
  id        String    @id @default(uuid())
  playerId  String    @map("player_id")
  teamId    String    @map("team_id")
  seasonId  String    @map("season_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  endReason String?   @map("end_reason")

  player Player @relation(fields: [playerId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([playerId, teamId, seasonId])
  @@map("team_assignments")
}

// Veza roditelj–dijete (M:N — dijete može imati oba roditelja, roditelj više djece)
model ParentLink {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  playerId  String   @map("player_id")
  relation  String?
  isPrimary Boolean  @default(true) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([userId, playerId])
  @@map("parent_links")
}

// Pozivni kod po igračici — roditelj njime aktivira nalog i vezuje se za dijete
model InviteCode {
  id           String    @id @default(uuid())
  code         String    @unique
  playerId     String    @map("player_id")
  usedByUserId String?   @map("used_by_user_id")
  usedAt       DateTime? @map("used_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])
  usedBy User?  @relation(fields: [usedByUserId], references: [id])

  @@map("invite_codes")
}

// ===== Faza 2: operativa =====

// Odgovor na poziv (utakmica/trening): da li dijete dolazi — odgovara roditelj ili igračica 16+
model Availability {
  id            String             @id @default(uuid())
  eventId       String             @map("event_id")
  playerId      String             @map("player_id")
  status        AvailabilityStatus
  reason        String?
  respondedById String             @map("responded_by_id")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  event       ScheduleEvent @relation(fields: [eventId], references: [id])
  player      Player        @relation(fields: [playerId], references: [id])
  respondedBy User          @relation(fields: [respondedById], references: [id])

  @@unique([eventId, playerId])
  @@map("availability")
}

// Objava trenera/kluba ekipi — jednosmjerna, sa evidencijom čitanja
model Announcement {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  authorId    String   @map("author_id")
  title       String
  body        String
  requiresAck Boolean  @default(false) @map("requires_ack")
  createdAt   DateTime @default(now()) @map("created_at")

  team   Team               @relation(fields: [teamId], references: [id])
  author User               @relation(fields: [authorId], references: [id])
  reads  AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

// ===== Faza 3: administracija =====

// Šifarnik tipova dokumenata (ljekarski pregled, pristupnica...)
model DocumentType {
  id          String  @id @default(uuid())
  name        String  @unique
  isRequired  Boolean @default(true) @map("is_required")
  validMonths Int?    @map("valid_months")
  sortOrder   Int     @default(0) @map("sort_order")

  playerDocuments PlayerDocument[]

  @@map("document_types")
}

// Predati dokument igračice, sa rokom važenja
model PlayerDocument {
  id        String    @id @default(uuid())
  playerId  String    @map("player_id")
  typeId    String    @map("type_id")
  fileUrl   String?   @map("file_url")
  issuedAt  DateTime  @map("issued_at")
  expiresAt DateTime? @map("expires_at")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  player Player       @relation(fields: [playerId], references: [id])
  type   DocumentType @relation(fields: [typeId], references: [id])

  @@map("player_documents")
}

// Saglasnost roditelja — media saglasnost je brava za javne fotografije/roster
model Consent {
  id         String      @id @default(uuid())
  playerId   String      @map("player_id")
  type       ConsentType
  signedById String      @map("signed_by_id")
  signedAt   DateTime    @default(now()) @map("signed_at")
  revokedAt  DateTime?   @map("revoked_at")
  version    String      @default("v1")

  player   Player @relation(fields: [playerId], references: [id])
  signedBy User   @relation(fields: [signedById], references: [id])

  @@map("consents")
}

// Mjesečna članarina po igračici (ručna evidencija u v1)
model MembershipFee {
  id        String    @id @default(uuid())
  playerId  String    @map("player_id")
  year      Int
  month     Int
  amountEur Float     @map("amount_eur")
  status    FeeStatus @default(unpaid)
  paidAt    DateTime? @map("paid_at")
  method    String?
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, year, month])
  @@map("membership_fees")
}

// Medicinske napomene — pun sadržaj vidi roditelj/admin; treneru samo coachNote
model MedicalInfo {
  id        String   @id @default(uuid())
  playerId  String   @unique @map("player_id")
  notes     String?
  coachNote String?  @map("coach_note")
  updatedAt DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id])

  @@map("medical_info")
}

model EmergencyContact {
  id       String  @id @default(uuid())
  playerId String  @map("player_id")
  name     String
  phone    String
  relation String?

  player Player @relation(fields: [playerId], references: [id])

  @@map("emergency_contacts")
}

// Termin probnog treninga sa kapacitetom
model TrialSlot {
  id        String   @id @default(uuid())
  startsAt  DateTime @map("starts_at")
  category  String?
  capacity  Int      @default(10)
  location  String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  registrations Registration[]

  @@map("trial_slots")
}

// ===== Faza 4: razvojni sloj =====

// Šifarnik kriterijuma ocjenjivanja; category=null važi za sve kategorije
model Criterion {
  id        String       @id @default(uuid())
  domain    EvalDomain
  name      String
  category  TeamCategory?
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")

  scores EvaluationScore[]

  @@map("criteria")
}

// Formalna evaluacija igračice (2x po sezoni + vanredne)
model Evaluation {
  id          String   @id @default(uuid())
  playerId    String   @map("player_id")
  coachUserId String   @map("coach_user_id")
  period      String
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  player Player            @relation(fields: [playerId], references: [id])
  coach  User              @relation(fields: [coachUserId], references: [id])
  scores EvaluationScore[]

  @@map("evaluations")
}

model EvaluationScore {
  id           String @id @default(uuid())
  evaluationId String @map("evaluation_id")
  criterionId  String @map("criterion_id")
  score        Int

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  criterion  Criterion  @relation(fields: [criterionId], references: [id])

  @@unique([evaluationId, criterionId])
  @@map("evaluation_scores")
}

// Razvojni cilj — jezik ohrabrenja, 1-3 aktivna po igračici
model DevelopmentGoal {
  id          String     @id @default(uuid())
  playerId    String     @map("player_id")
  coachUserId String     @map("coach_user_id")
  title       String
  description String?
  status      GoalStatus @default(active)
  dueDate     DateTime?  @map("due_date")
  createdAt   DateTime   @default(now()) @map("created_at")
  doneAt      DateTime?  @map("done_at")

  player Player @relation(fields: [playerId], references: [id])
  coach  User   @relation(fields: [coachUserId], references: [id])

  @@map("development_goals")
}

// Prekretnica/bedž (ručna ili automatska: promocija, jubilej treninga...)
model Milestone {
  id         String   @id @default(uuid())
  playerId   String   @map("player_id")
  title      String
  kind       String   @default("manual")
  badge      String?
  achievedAt DateTime @default(now()) @map("achieved_at")

  player Player @relation(fields: [playerId], references: [id])

  @@map("milestones")
}

// Povreda i povratak na teren; trener vidi status + sportsku napomenu
model InjuryRecord {
  id         String       @id @default(uuid())
  playerId   String       @map("player_id")
  status     InjuryStatus
  note       String?
  startedAt  DateTime     @default(now()) @map("started_at")
  returnedAt DateTime?    @map("returned_at")

  player Player @relation(fields: [playerId], references: [id])

  @@map("injury_records")
}

// Pristupnica za članstvo u klubu (podržavajući članovi)
model ClubMember {
  id        String             @id @default(uuid())
  fullName  String             @map("full_name")
  email     String
  phone     String?
  message   String?
  status    RegistrationStatus @default(pending)
  createdAt DateTime           @default(now()) @map("created_at")

  @@map("club_members")
}

// Evidencija opreme — zaduženje po igračici (playerId=null → klupska oprema)
model EquipmentItem {
  id         String    @id @default(uuid())
  playerId   String?   @map("player_id")
  itemType   String    @map("item_type")
  label      String?
  size       String?
  issuedAt   DateTime  @default(now()) @map("issued_at")
  returnedAt DateTime? @map("returned_at")
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")

  player Player? @relation(fields: [playerId], references: [id])

  @@map("equipment_items")
}

// ===== Finansijska evidencija (blagajna; zvanično knjigovodstvo radi knjigovođa) =====
model FinanceEntry {
  id          String      @id @default(uuid())
  kind        FinanceKind
  category    String
  amountEur   Float       @map("amount_eur")
  date        DateTime
  description String?
  receiptUrl  String?     @map("receipt_url")
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("finance_entries")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("push_tokens")
}

model Trener {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  role      String
  category  String?
  bio       String?
  licenseNo String?  @map("license_no")
  photoUrl  String?  @map("photo_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("treneri")
}
